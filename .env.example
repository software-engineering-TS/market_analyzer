# Copy to .env and replace all placeholder secrets.
APP_NAME=Market Analyzer
APP_VERSION=1.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=market_analyzer
DB_USER=market_analyzer
DB_PASSWORD=replace_with_a_local_database_password

# JWT: generate a random secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
